{
  "name": "YPE · Free Creator Starter Pack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ype-free-pack",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://ypemedia.com"
        }
      },
      "id": "n1",
      "name": "Webhook /ype-free-pack",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ype-free-pack"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Valid email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "email",
              "value": "={{ $json.body.email.trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "firstName",
              "value": "={{ ($json.body.name || '').trim() || 'there' }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "engaged",
              "value": "={{ $json.body.engaged === true }}",
              "type": "boolean"
            },
            {
              "id": "a4",
              "name": "source",
              "value": "={{ $json.body.source || 'site' }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "lang",
              "value": "={{ $json.body.lang || '' }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "unlockLink",
              "value": "https://ypemedia.com/editor/?unlock=creator-starter-7f3a",
              "type": "string"
            },
            {
              "id": "a7",
              "name": "date",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n3",
      "name": "Prepare lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        -80
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Your Creator Starter Pack unlock link",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;padding:32px 24px;color:#542f28;background:#f5f1e9\">\n<p style=\"font-size:11px;letter-spacing:2px;color:#95725c;margin:0 0 24px\">YPE MEDIA · CREATOR STARTER PACK</p>\n<h1 style=\"font-family:Georgia,serif;font-weight:400;font-size:34px;line-height:1.05;margin:0 0 18px\">Hi {{ $json.firstName }}, your six designs are ready</h1>\n<p style=\"font-size:15px;line-height:1.7;margin:0 0 26px\">Open the link below once and the Creator Starter Pack stays unlocked in your browser: a quote card, a stat post, a socials plate, a carousel cover and ending, and a text hook. Full size, no watermark, every platform.</p>\n<p style=\"margin:0 0 30px\"><a href=\"{{ $json.unlockLink }}\" style=\"display:inline-block;background:#542f28;color:#f5f1e9;text-decoration:none;padding:16px 28px;border-radius:40px;font-size:15px\">Unlock my free pack</a></p>\n<p style=\"font-size:13px;line-height:1.7;color:#8b7566;margin:0 0 26px\">Tip: the designs are 4:5, the size LinkedIn uses for image posts. Export the carousel slides as PNG, drop them into one PDF and post it as a document.</p>\n<p style=\"font-size:13px;line-height:1.7;margin:0 0 6px\">Want all 34 designs plus the Figma, Canva and After Effects files? <a href=\"https://ypemedia.com/#shop\" style=\"color:#e17145\">The Template Kit is $29</a>.</p>\n<p style=\"font-size:13px;line-height:1.7;margin:26px 0 0\">YPE Media team<br><a href=\"https://ypemedia.com\" style=\"color:#95725c\">ypemedia.com</a></p>\n<p style=\"font-size:11px;color:#a28c7a;margin:30px 0 0\">You asked for this link at ypemedia.com/free. If it wasn't you, just ignore this email.</p>\n</div>",
        "options": {
          "senderName": "YPE Media",
          "replyTo": "info@ypemedia.com"
        }
      },
      "id": "n4",
      "name": "Gmail: send unlock link",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        -80
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail info@ypemedia.com"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $('Prepare lead').item.json.date }}",
            "email": "={{ $('Prepare lead').item.json.email }}",
            "name": "={{ $('Prepare lead').item.json.firstName }}",
            "engaged": "={{ $('Prepare lead').item.json.engaged }}",
            "source": "={{ $('Prepare lead').item.json.source }}",
            "lang": "={{ $('Prepare lead').item.json.lang }}"
          }
        },
        "options": {}
      },
      "id": "n5",
      "name": "Google Sheets: log lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        960,
        -80
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "n6",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'invalid email' } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "n7",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        160
      ]
    }
  ],
  "connections": {
    "Webhook /ype-free-pack": {
      "main": [
        [
          {
            "node": "Valid email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid email?": {
      "main": [
        [
          {
            "node": "Prepare lead",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare lead": {
      "main": [
        [
          {
            "node": "Gmail: send unlock link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail: send unlock link": {
      "main": [
        [
          {
            "node": "Google Sheets: log lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets: log lead": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}